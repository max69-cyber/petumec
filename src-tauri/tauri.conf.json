{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "petumec",
  "version": "0.1.0",
  "identifier": "com.rayxaus.petumec",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "pet-overlay",
        "title": "petumec",
        "width": 128,
        "height": 128,
        "transparent": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "acceptFirstMouse": true,
        "alwaysOnTop": true,
        "visible": false,
        "visibleOnAllWorkspaces": true,
        "shadow": false,
        "focus": false,
        "resizable": false,
        "closable": false,
        "minimizable": false,
        "maximizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
